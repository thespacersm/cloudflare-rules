{
  "id": "fpc-catalog",
  "name": "FULL PAGE CACHE (FPC) - CATALOG",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": {
      "mode": "override_origin",
      "default": 86400,
      "status_code_ttl": [
        {
          "status_code_range": {
            "from": 500,
            "to": 599
          },
          "value": -1
        },
        {
          "status_code_range": {
            "from": 400,
            "to": 499
          },
          "value": 300
        }
      ]
    },
    "browser_ttl": {
      "mode": "respect_origin"
    },
    "cache_key": {
      "custom_key": {
        "query_string": {
          "exclude": {
            "list": [
              "utm_source",
              "utm_medium",
              "utm_campaign",
              "utm_term",
              "utm_content",
              "gclid",
              "fbclid",
              "msclkid",
              "gbraid",
              "wbraid"
            ]
          }
        }
      }
    }
  },
  "description": "E-commerce con filtri e ricerca: edge TTL forzato a 1 giorno, query string nella cache key tranne i parametri di tracking.",
  "expression": "http.request.method in {\"GET\" \"HEAD\"}"
}