{
  "id": "fpc-static",
  "name": "FULL PAGE CACHE (FPC) - STATIC",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": {
      "mode": "override_origin",
      "default": 2592000,
      "status_code_ttl": [
        {
          "status_code_range": {
            "from": 500,
            "to": 599
          },
          "value": -1
        },
        {
          "status_code_range": {
            "from": 400,
            "to": 499
          },
          "value": 300
        }
      ]
    },
    "browser_ttl": {
      "mode": "respect_origin"
    },
    "cache_key": {
      "custom_key": {
        "query_string": {
          "exclude": {
            "all": true
          }
        }
      }
    }
  },
  "description": "Sito full static: edge TTL forzato a 30 giorni (ignora Cache-Control dell'origin), query string ignorata.",
  "expression": "http.request.method in {\"GET\" \"HEAD\"}"
}