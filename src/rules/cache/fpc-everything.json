{
  "id": "fpc-everything",
  "name": "FULL PAGE CACHE (FPC)",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": {
      "mode": "override_origin",
      "default": 86400,
      "status_code_ttl": [
        {
          "status_code_range": {
            "from": 500,
            "to": 599
          },
          "value": -1
        },
        {
          "status_code_range": {
            "from": 400,
            "to": 499
          },
          "value": 300
        }
      ]
    },
    "browser_ttl": {
      "mode": "respect_origin"
    },
    "cache_key": {
      "custom_key": {
        "query_string": {
          "exclude": {
            "all": true
          }
        }
      }
    }
  },
  "description": "Memorizza in cache qualsiasi richiesta di lettura GET o HEAD per la navigazione pubblica.",
  "expression": "http.request.method in {\"GET\" \"HEAD\"}"
}